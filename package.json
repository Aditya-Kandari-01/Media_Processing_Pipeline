{
  "name": "intelligent-media-processing-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "Backend + AI engineering take-home assignment: asynchronous vehicle image analysis pipeline.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "api": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "bullmq": "^5.58.0",
    "express": "^5.1.0",
    "ioredis": "^5.6.1",
    "mongoose": "^9.9.0",
    "multer": "^2.0.2",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.34.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.10",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
